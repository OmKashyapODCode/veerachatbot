# =============================================================================
# Vera Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# ---- LLM Provider ----
# Options: gemini, openai, anthropic, deepseek, groq
LLM_PROVIDER=gemini

# Your LLM API key (required)
LLM_API_KEY=your_api_key_here

# Optional: specify model (leave empty for provider default)
# gemini: gemini-2.0-flash, gemini-1.5-pro
# openai: gpt-4o, gpt-4o-mini
# anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# deepseek: deepseek-chat
# groq: llama-3.1-70b-versatile
LLM_MODEL=gemini-2.0-flash

# LLM request timeout in seconds
LLM_TIMEOUT=20

# ---- Team / Submission Identity ----
TEAM_NAME=Team Vera
TEAM_MEMBERS=Member1,Member2
CONTACT_EMAIL=contact@example.com
APP_VERSION=1.0.0
MODEL_NAME=gemini-2.0-flash
SUBMITTED_AT=2026-09-27T00:00:00Z

# ---- Server ----
# PORT is set automatically by Render/Railway/Fly
PORT=8080
HOST=0.0.0.0
